# Ignore dependencies and build output
dist
out

# Ignore Vite, Webpack, and React-specific build artifacts
.vite
.vitepress
.eslintcache
.npm
coverage
jest
cypress
cypress/screenshots/
cypress/videos/
reports

# Ignore environment and config files (sensitive data)
*.env*
*.log

# Ignore TypeScript build artifacts (if using TypeScript)
*.tsbuildinfo

# Ignore lockfiles (optional if using Docker for package installation)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Ignore local development files
.git
.gitignore
.vscode
.idea
*.swp
.DS_Store
Thumbs.db

# Ignore build-specific cache files
*.lock

__pycache__
.venv
.classpath
.project
.settings
.toolstarget
.vs
*.*proj.user
*.dbmdl
*.jfm
bin
charts
docker-compose*
compose*
Dockerfile*
node_modules
npm-debug.log
obj
secrets.dev.yaml
values.dev.yaml
LICENSE
README.md
