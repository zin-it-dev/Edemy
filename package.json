{
  "name": "edemy",
  "private": true,
  "version": "1.0.0",
  "description": "Discover and learn about any topic 🔖",
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "dev:web": "turbo run dev --filter=web",
    "test:web": "turbo run test --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "test:api": "turbo run test --filter=api"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viktorcyber/edemy.git"
  },
  "keywords": [],
  "author": {
    "name": "viktorcyber",
    "email": "zin.it.dev@gmail.com",
    "url": "https://github.com/viktorcyber/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/viktorcyber/edemy/issues"
  },
  "homepage": "https://github.com/viktorcyber/edemy#readme",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "turbo": "^2.8.7"
  }
}
