{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "DJANGO_SECRET_KEY",
    "DJANGO_DATABASE_URI",
    "VITE_APP_TITLE",
    "VITE_CLERK_PUBLISHABLE_KEY"
  ],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
